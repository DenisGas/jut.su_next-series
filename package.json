{
  "name": "jut.su_next-series",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build:chrome:dev": "cross-env BROWSER=chrome NODE_ENV=development webpack --config webpack.config.js",
    "build:firefox:dev": "cross-env BROWSER=firefox NODE_ENV=development webpack --config webpack.config.js",
    "build:chrome:prod": "cross-env BROWSER=chrome NODE_ENV=production webpack --config webpack.config.js",
    "build:firefox:prod": "cross-env BROWSER=firefox NODE_ENV=production webpack --config webpack.config.js",
    "build:dev": "npm run build:chrome:dev && npm run build:firefox:dev",
    "build:prod": "npm run build:chrome:prod && npm run build:firefox:prod",
    "prepare": "husky",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write .",
    "i18n:json-to-csv": "node localization-tools/convert.js json2csv",
    "i18n:json-to-csv:log": "node localization-tools/convert.js json2csv --log",
    "i18n:csv-to-json": "node localization-tools/convert.js csv2json && prettier --write ./src/_locales && prettier --write ./src/scripts/modules/common/localizationKeys.js",
    "i18n:csv-to-json:log": "node localization-tools/convert.js csv2json --log && prettier --write ./src/_locales && prettier --write ./src/scripts/modules/common/localizationKeys.js"
  },
  "lint-staged": {
    "**/*.{js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,html}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "webextension-polyfill": "^0.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.1",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-webpack": "^0.13.9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0",
    "zip-webpack-plugin": "^4.0.1"
  }
}
