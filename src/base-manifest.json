{
  "name": "jut.su Next-Series",
  "description": "__MSG_extensionDescription__",
  "version": "3.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "./icons/16.png",
    "32": "./icons/32.png",
    "48": "./icons/48.png",
    "128": "./icons/128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "css": ["./styles/contentStyle.css"],
      "js": ["./scripts/content.js"],
      "matches": ["*://jut.su/*"],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en"
}
